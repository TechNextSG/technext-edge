# Copy to .env.local (git-ignored) for `npm run dev:bff`, and set the same
# key in the Vercel project's environment variables (production + preview
# separately — preview should get its own key with a lower spend cap).

# Demo default provider — see docs/adr/ADR-005a-extractor-model.md for why
# Gemini is the starting point and not yet the eval-decided winner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
