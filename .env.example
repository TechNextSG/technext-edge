# Primary / Default Provider: DeepSeek Flash via LiteLLM Gateway
# EXTRACTOR_PROVIDER=deepseek-flash
DEEPSEEK_GATEWAY_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Secondary / Fallback Provider: Google Gemini
GEMINI_API_KEY=
# Options: gemini-3.1-flash (newest), gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-3.1-flash

# Optional: Set to 1 to include detailed Zod issues & stack traces in error responses
# DEBUG_EXTRACT=1

# WhatsApp inbound channel (Meta Cloud API) — POST /v1/channels/whatsapp/webhook
# None of these are needed to run the extractor or its tests.
#
# A string YOU invent and paste into both the Meta app dashboard and here; Meta
# echoes it back on the one-time GET subscription handshake. Meta never issues it.
WHATSAPP_VERIFY_TOKEN=

# Meta app secret. Verifies the X-Hub-Signature-256 header on every inbound
# message — leave it empty and the webhook 500s rather than trusting anyone who
# finds the public URL.
WHATSAPP_APP_SECRET=

# Permanent token + the WhatsApp Business phone number's ID (not the number
# itself), used to send the reply back. Missing either one and the webhook still
# acks Meta, but cannot answer the guest.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The number has to be REGISTERED for Cloud API before the first send works. That
# step is API-only (no WhatsApp Manager button): POST /<phone-number-id>/register
# with a 6-digit pin. Until it is done every send answers 133010 "Account not
# registered" however healthy the token looks.

# Optional: only read by scripts/whatsapp-check.mjs. Paired with the app secret it
# calls debug_token, which is how you prove the token above is a system user token
# (expires_at=0) rather than the dashboard's 24h temporary one.
# WHATSAPP_APP_ID=

# Optional: Graph API version, per-send timeout, and the whole-turn deadline
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_MS=10000
# Meta redelivers a webhook we have not answered (measured at +23s on
# 2026-09-18), so a turn that outlives this deadline is abandoned and its message
# id released — which lets that redelivery answer the guest for real. The default
# stays below Meta's patience so the abandoned turn is the one that loses.
# WHATSAPP_TURN_TIMEOUT_MS=20000

# Estimator BFF — the ONLY path from this service to Odoo.
#
# `POST {ESTIMATOR_BASE_URL}/api/estimates` with `{trip}` is how a quotation gets priced, and
# `POST .../:id/commit` + `POST .../:id/share` are how a staff member turns a price into the guest
# link. This service holds no Odoo credential of any kind: per the edge spec §1, every call goes
# through the BFF and the Odoo key lives only on that server.
#
# ESTIMATOR_MODE picks which engine answers, and it defaults to `simulated` ON PURPOSE: a deployment
# that forgets this variable must not try to reach an Odoo-backed host with no credentials. Set it
# to `remote` deliberately, and then set the URL below — `remote` with no URL answers 503 and the
# status badge beside the button says so, which is what to check first if pricing looks dead.
#
#   simulated  the built-in engine (apps/casa-bff/src/simulatedEstimator.ts): answers in the
#              customer's own response shape and reproduces their captured fixtures, so the whole
#              flow — price, per-guest breakdown, ops sheet, publish — runs with no network at all.
#              Every price is labelled sample. For local dev and tests.
#   remote     their BFF, and through it Odoo. This is what a demo or production wants.
#
# Their BFF had no production deployment as of 2026-09-25, so a demo deployment of THEIR code was
# made under our Vercel team and pointed to here (see docs/upstream-note-bff-vercel-deploy.md). It
# runs FIXTURE_MODE=1, so every price is a captured sample and is flagged as such by our fixture
# detection — which is why publishing one needs staff to tick an acknowledgement. When they deploy
# their own BFF against real Odoo, repoint this and remove the demo deployment.
#
# ESTIMATOR_MODE=remote
# ESTIMATOR_BASE_URL=https://tn-casa-estimator-fixture.vercel.app
# ESTIMATOR_TIMEOUT_MS=12000

# Enable the Hono quotation tool: when the extractor finishes an enquiry, build an editable
# quotation draft (line items + a link) and save it for staff to review. On, the bot stops at "the
# team is preparing your quotation" and never sends a price or a link itself — a price reaches a
# guest only when a person publishes it from the studio.
# ENABLE_HONO_QUOTATION_TOOL=true

# Upstash Redis (REST) — durable storage for two stores:
#   • the conversation store (WhatsApp thread history, per-number locks, handoff state)
#   • the quotation store (the draft behind a guest's /q/:slug link)
#
# One database serves both, and both read the same two vars (either spelling works):
#   KV_REST_API_URL        (or UPSTASH_REDIS_REST_URL)
#   KV_REST_API_TOKEN      (or UPSTASH_REDIS_REST_TOKEN)
#
# WHY: Vercel Functions have no filesystem or memory between requests, so a quotation link must
# live in a durable store or it dies on every deploy/cold start — which was the measured bug this
# fixed (a guest link returned 200 before a redeploy, 404 after). Conversation state is transient
# (it carries a TTL); quotations carry NO TTL on purpose: they are business records, and a link a
# staff member pasted into WhatsApp must outlive the 24h WhatsApp window.
#
# Unset, BOTH stores silently fall back to in-process memory — correct for local dev, and the
# conversation store logs "NO KV CONFIGURED IN PRODUCTION" when that fallback happens under
# NODE_ENV=production so the mistake is visible in the logs.
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

