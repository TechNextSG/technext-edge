  "cards": [
    {
      "dot": "cyan",
      "title": "Before any work",
      "items": [
        "The signature is checked against the app secret in constant time",
        "A message id seen before is acknowledged and ignored, so Meta's retry never doubles a reply"
      ]
    },
    {
      "dot": "emerald",
      "title": "Only when done",
      "items": [
        "A draft quotation is written only when every required fact is known",
        "An impossible room or a partner goes to staff instead of an automatic draft"
      ]
    },
    {
      "dot": "rose",
      "title": "Reply rules",
      "items": [
        "No money, no booking promise, no link in a guest message",
        "A failed model call becomes an honest 'a person will reply' message"
