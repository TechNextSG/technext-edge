  "cards": [
    {
      "dot": "cyan",
      "title": "Key-Value & Document Model",
      "items": [
        "The pre-migration system stores state in Upstash Redis REST without relational schemas or foreign keys",
        "A quotation is a single monolithic JSON document (HonoQuotationDraft) holding nested trips, lines and submissions"
      ]
    },
    {
      "dot": "amber",
      "title": "Ephemeral WhatsApp Concurrency",
      "items": [
        "Meta webhooks are deduplicated via claim:{id} with fence tokens, expiring after 60 seconds or 24 hours",
        "Per-phone turns are protected by a 30s distributed lease (phonelock) and paused threads queue in a Redis SET"
      ]
    },
    {
      "dot": "rose",
      "title": "Migration Driver to Supabase PostgreSQL",
      "items": [
        "Redis lacks atomic multi-key transactions, queryable indexes for staff queues, and PII audit compliance",
        "PostgreSQL migration normalizes the draft into scenario, revision, ai_enquiry and typed conversation tables"
      ]
    }
  ]
