node_modules/
dist/
.env
.env.local
.vercel/
*.tsbuildinfo
.DS_Store

# Eval run artifacts (may echo real guest text back) and the real dataset
# itself — this must never be committed once Eloa's 30 messages exist here.
packages/extractor/eval/results.*.json
packages/extractor/eval/results-*.json
packages/extractor/eval/results*.log
packages/extractor/eval/dataset.real.json

.vercel
.env*
~$*.xlsx
tmp-*.log

# One-off measurement scripts run by hand against a live provider key. Keeping them here
# also keeps them out of the deployment bundle, because .vercelignore defaults to this file.
.scratch-measure/

# Archify visual-check artifacts. They are regenerated on every pass — several MB of PNGs per
# diagram — and the pass/fail verdict is what matters, not the images, for the same reason a build
# log is not committed. The pattern is deliberately loose: the files carry a viewport and a theme in
# their names (`x.visual-check.1440x900.dark.png`), so a per-extension rule would miss them.
*.visual-check.*

cookies.txt
